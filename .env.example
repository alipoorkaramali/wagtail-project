# ============================================================
#  Environment Variables Template
#  Copy this to .env locally, or set these in your cloud host UI
# ============================================================

# --- Django ---
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# --- Database ---
# For local dev, leave empty (uses SQLite)
# For cloud, provide a PostgreSQL URL like:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- MCP Bridge ---
# Token created via: python manage.py api_tokens create --user=<username> --name=<name>
# IMPORTANT: Must start with "wagtail_"
MCP_TOKEN=wagtail_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target URL where wagtail-mcp lives (Django service)
# Local:  http://127.0.0.1:8000/mcp/
# Cloud:  https://your-wagtail-app.onrender.com/mcp/
MCP_TARGET_URL=http://127.0.0.1:8000/mcp/

# Public URL of the bridge itself (used in SSE endpoint message)
# Local:  https://tall-mandate-safely.ngrok-free.dev
# Cloud:  https://your-bridge.onrender.com
MCP_PUBLIC_URL=https://your-bridge.onrender.com

# Bridge port (usually set automatically by the cloud host)
# MCP_PORT=8002

# --- Django Superuser (for initial bootstrap) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-production
